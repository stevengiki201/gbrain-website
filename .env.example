# Site
NEXT_PUBLIC_SITE_URL="https://gbrain.tech"
NEXT_PUBLIC_SITE_NAME="GBrain Technologies"

# Contact email destination (required in production)
CONTACT_TO_EMAIL="hello@gbrain.tech"

# Resend (email delivery, required in production)
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
RESEND_FROM_EMAIL="GBrain Contact <contact@gbrain.tech>"

# GitHub (release/download links)
GITHUB_TOKEN=""
GITHUB_OWNER="stevengiki201"
GITHUB_REPO="gbrain-website"

# PhoneLink web dashboard (local subdomain by default)
NEXT_PUBLIC_PHONELINK_DASHBOARD_URL="http://phonelink.localhost:7842"
# Production: NEXT_PUBLIC_PHONELINK_DASHBOARD_URL="https://phonelink.gbrain.tech"

# User accounts and SMS dashboard
SESSION_SECRET="replace-with-a-long-random-secret"
GBRAIN_DATA_DIR="./data"
NEXT_PUBLIC_SMS_DASHBOARD_URL="http://localhost:3000/dashboard/sms"
GBRAIN_CONFIRMED_EMAILS="owner@gbrain.tech"
GBRAIN_ADMIN_EMAILS=""
GBRAIN_SERVICE_TOKEN="replace-with-a-long-random-service-token"
GBRAIN_AUDIOLINK_BRIDGE_URL="https://sms.gbrain.tech"

# Company admin monitoring
CRON_SECRET="replace-with-a-long-random-cron-secret"
GBRAIN_INTERNAL_BASE_URL="http://localhost:3000"
GBRAIN_SMS_BRIDGE_URL="https://sms.gbrain.tech/v1/health"
GBRAIN_NEURAL_URL=""
GBRAIN_PHONELINK_URL=""

# Feature flags
NEXT_PUBLIC_ENABLE_ADMIN=false
